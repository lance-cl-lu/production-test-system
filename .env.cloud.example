# Local cloud simulation. Change only endpoints/secrets when deploying to real cloud.
CLOUD_UPLOAD_ENABLED=true
CLOUD_API_URL=http://cloud-receiver:8100/api/v1/sync/batch
CLOUD_API_KEY=replace-this-before-production
CLOUD_SYNC_INTERVAL_SECONDS=10
CLOUD_API_PORT=8100
CLOUD_FRONTEND_PORT=3100
CLOUD_PUBLIC_API_URL=http://localhost:8100
CLOUD_MYSQL_PORT=3307
CLOUD_MYSQL_DATABASE=production_test_cloud
CLOUD_MYSQL_USER=clouduser
CLOUD_MYSQL_PASSWORD=cloudpassword
CLOUD_MYSQL_ROOT_PASSWORD=cloudrootpassword
