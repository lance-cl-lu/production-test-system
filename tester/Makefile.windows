# Windows/MSYS2: pacman -S --needed mingw-w64-x86_64-gcc make
# macOS cross-build: brew install mingw-w64

ifeq ($(OS),Windows_NT)
CC = gcc
else
CC = x86_64-w64-mingw32-gcc
endif
CFLAGS := -O2 -Wall -Wextra -D_WIN32_WINNT=0x0601
LDFLAGS := -lwinhttp

SOURCES := sensor_watcher.c uart_hvf.c uart_hvf_sensors.c \
           platform_windows.c platform_http_windows.c

.PHONY: all clean

all: sensor_watcher.exe

sensor_watcher.exe: $(SOURCES)
	$(CC) $(CFLAGS) -o $@ $(SOURCES) $(LDFLAGS)

clean:
	rm -f sensor_watcher.exe
