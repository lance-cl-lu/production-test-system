# Database
DATABASE_URL=mysql+pymysql://testuser:testpassword@localhost:3306/production_test

# Cloud Upload (Optional)
CLOUD_UPLOAD_ENABLED=false
CLOUD_API_URL=https://your-cloud-api.com/upload
CLOUD_API_KEY=your-api-key

# Sensor watcher (native backend only; leave path empty to use ../tester/sensor_watcher)
AUTO_START_SENSOR_WATCHER=true
SENSOR_WATCHER_EXECUTABLE=

# Scheduler
UPLOAD_SCHEDULE_HOURS=1

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
